# =====================================================
# PKBM MUGI SAE - Environment Variables
# =====================================================
# Copy this file to `.env` and adjust the values for your
# local / production environment. NEVER commit `.env`.

# -----------------------------------------------------
# Database
# -----------------------------------------------------
DATABASE_URL=postgresql://pkbm_user:pkbm_pass@localhost:5432/pkbm_mugi_sae

# Untuk docker-compose (postgres service)
POSTGRES_USER=pkbm_user
POSTGRES_PASSWORD=pkbm_pass
POSTGRES_DB=pkbm_mugi_sae

# -----------------------------------------------------
# Server
# -----------------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------
# JWT
# -----------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------
# Email (nodemailer)
# -----------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="PKBM MUGI SAE <noreply@pkbmmugiasae.sch.id>"

# -----------------------------------------------------
# Upload
# -----------------------------------------------------
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# -----------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------
VITE_API_URL=http://localhost:5000/api

# -----------------------------------------------------
# pgAdmin (opsional, profile: tools)
# -----------------------------------------------------
PGADMIN_EMAIL=admin@pkbmmugiasae.sch.id
PGADMIN_PASSWORD=admin123
